# pocketd environment
OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=

POCKETD_PORT=8788

# ntfy (background push). NTFY_TOPIC is required to enable the channel.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=opencode-pocket-CHANGE-ME
NTFY_TOKEN=

# Deep link scheme used in notification "click" (opened by the iOS app)
POCKET_URL_SCHEME=opencodepocket

# Notify on session.idle too (default: false; can be noisy)
NOTIFY_IDLE=false
