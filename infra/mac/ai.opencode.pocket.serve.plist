<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.opencode.pocket.serve</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/infra/mac/run-serve.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__HOME__/.local/state/opencode-pocket/serve.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.local/state/opencode-pocket/serve.err.log</string>
</dict>
</plist>
