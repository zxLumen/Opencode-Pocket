{
  "$schema": "https://opencode.ai/config.json",
  "model": "zxgw/gateway-default",
  "small_model": "zxgw/gateway-default",
  "share": "disabled",
  "websearch": {
    "provider": "exa"
  },
  "provider": {
    "zxgw": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "博客 AI 网关",
      "options": {
        "baseURL": "http://app:3000/api/ai/v1",
        "apiKey": "{env:ZX_AI_APP_TOKEN}"
      },
      "models": {
        "gateway-default": {
          "name": "网关默认模型"
        }
      }
    }
  },
  "permission": {
    "external_directory": "deny",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": "allow"
  }
}
