# 访客沙盒 · 边缘 Caddy(站点地址 :80)—— 面向 opencode v2.0.27
#
# 三层职责:
#   ① 访客锁定 —— 文档请求只认唯一会话,其余 302 回工作台;裁剪版 UI + 外壳注入 + 门控
#   ② 工作台 —— GET / 返回双栏工作台(会话 | 网站实时预览)
#   ③ 模型封锁 —— 访客看不到可选模型、也换不了模型(读接口净化成「仅网关默认」+
#      写接口 403 + 前端隐藏模型入口)
#
# v2.0.27 与 v1.19 的关键差异(本文件据此改写):
#   - API 全部在 /api/* 下(/api/session、/api/config、/api/provider、/api/model…);
#   - opencode 绑 0.0.0.0 时**强制 Basic 鉴权** → 本服务向上游注入 Authorization,
#     对访客透明(访客侧不暴露任何凭据);
#   - UI 资源前缀 /_assets/*,图标 /icons/prod/*。
#
# 本服务不发布端口,由博客栈的 Caddy 做 TLS 后转发到 sandbox-caddy:80。
# 会话 id 用 {$PLAYGROUND_SESSION_ID:ses_guest}(默认 ses_guest,由 compose 注入)。
# 上游鉴权用 {$SANDBOX_UPSTREAM_AUTH}(形如 "Basic <base64>",由 compose 注入)。

# 上游转发片段:注入 Basic 凭据(覆盖客户端自带值),SSE 关闭缓冲
(to_oc) {
	reverse_proxy opencode-play:4096 {
		header_up Authorization "{$SANDBOX_UPSTREAM_AUTH}"
		header_up -Cookie
		flush_interval -1
	}
}
(to_helper) {
	reverse_proxy opencode-play:47311
}

:80 {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# ⓪ 响应压缩(bundle 较大;SSE 带 no-transform 会自动跳过)
	encode zstd gzip

	# ① 危险族:读+写全封(文件系统 / PTY / shell 执行 / 凭据 / MCP / 集成 / 插件 /
	#    debug / experimental / rpc / 配对 / 配置 shell)。这些能力对公开沙盒一律不可达。
	@bannedFamily path_regexp ^/api/(fs|pty|credential|mcp|integration|plugin|debug|experimental|rpc|pair|tui)(/|$)
	handle @bannedFamily {
		respond 403
	}
	@bannedShellExec path_regexp ^/api/shell/
	handle @bannedShellExec {
		respond 403
	}
	@bannedMisc path /api/location/reload /api/config/shell
	handle @bannedMisc {
		respond 403
	}
	# 会话内危险子操作:shell 工具 / fork
	@bannedSessionSub path_regexp ^/api/session/[^/]+/(shell|fork)(/|$)
	handle @bannedSessionSub {
		respond 403
	}
	# 改模型:POST 交给辅助服务强制成网关默认模型(忽略请求体);其余方法 403
	@sessionModel path_regexp ^/api/session/[^/]+/model$
	handle @sessionModel {
		@modelPost method POST
		handle @modelPost {
			import to_helper
		}
		handle {
			respond 403
		}
	}
	# 会话历史:交给辅助服务截断为最近 N 条(不再向更早翻页),缓解长会话的滚动抖动
	@sessionMessages path_regexp ^/api/session/[^/]+/message$
	handle @sessionMessages {
		import to_helper
	}

	# ② 网站预览 + 访客后端反代(全部方法透传到辅助服务)
	@preview path_regexp ^/preview(/|$)
	handle @preview {
		import to_helper
	}

	# ②b 直播投票:榜单状态 / SSE / 管理(交给辅助服务;管理由 token 保护)
	@liveBoard path_regexp ^/__lb(/|$)
	handle @liveBoard {
		import to_helper
	}

	# ③ 模型/配置「净化」:剥掉网关密钥,只暴露「博客 AI 网关」与其默认模型。
	#    (opencode v2.0.x 的 /api/provider、/api/model、/api/model/default 响应里
	#     settings 会带 apiKey,必须由辅助服务净化。)
	@configPath path /api/config
	handle @configPath {
		@cfgRead method GET HEAD
		handle @cfgRead {
			rewrite * /__config
			import to_helper
		}
		handle {
			respond 403
		}
	}
	@providerPath path /api/provider
	handle @providerPath {
		@provRead method GET HEAD
		handle @provRead {
			rewrite * /__provider
			import to_helper
		}
		handle {
			respond 403
		}
	}
	@modelPath path /api/model
	handle @modelPath {
		@modelRead method GET HEAD
		handle @modelRead {
			rewrite * /__model
			import to_helper
		}
		handle {
			respond 403
		}
	}
	@modelDefaultPath path /api/model/default
	handle @modelDefaultPath {
		@mdRead method GET HEAD
		handle @mdRead {
			rewrite * /__model-default
			import to_helper
		}
		handle {
			respond 403
		}
	}

	# ④ 裁剪版 UI 静态资源(由辅助服务从 /srv/app-dist 提供)
	@assets path_regexp ^/(_assets|assets|icons)/
	handle @assets {
		header Cache-Control "public, max-age=31536000, immutable"
		import to_helper
	}
	@rootFiles path /favicon.ico /favicon.svg /favicon-v3.ico /favicon-v3.svg /favicon-96x96.png /favicon-96x96-v3.png /apple-touch-icon.png /apple-touch-icon-v3.png /oc-theme-preload.js /site.webmanifest /social-share.png /social-share-zen.png /web-app-manifest-192x192.png /web-app-manifest-512x512.png
	handle @rootFiles {
		import to_helper
	}
	@sw path /sw.js
	handle @sw {
		import to_helper
	}

	# ⑤ HTML 文档请求
	@htmldoc header Accept *text/html*
	handle @htmldoc {
		# 入口 = 工作台(会话 | 网站预览)
		@rootDoc path / /hub
		handle @rootDoc {
			rewrite * /__hub
			import to_helper
		}
		# 固定会话路径 = 裁剪版 UI 外壳(嵌在工作台左栏)。URL 形如
		# /server/<base64(origin)>/session/<id>,由辅助服务注入外壳后返回终态 HTML。
		@atSession path_regexp ^/server/[^/]+/session/{$PLAYGROUND_SESSION_ID:ses_guest}(/|$)
		handle @atSession {
			header Content-Type "text/html; charset=utf-8"
			rewrite * /__shell
			import to_helper
		}
		# 直播投票榜页(OBS / 直播画面用;工作台内也以 iframe 内嵌)
		@boardDoc path /board
		handle @boardDoc {
			rewrite * /__board
			import to_helper
		}
		# 其它文档请求一律拉回工作台
		handle {
			redir * / 302
		}
	}

	# ⑥ 写入白名单:非 GET/HEAD/OPTIONS 仅放行固定会话下的子路径,其余 403
	#    (建会话 POST /api/session、改配置、加项目、worktree 刷新等全被挡;
	#     会话内 shell/fork/model 已在 ① 封禁;仅额外放行 Plan/Build 切换)
	@write not method GET HEAD OPTIONS
	@allowedSession path_regexp ^/api/session/{$PLAYGROUND_SESSION_ID:ses_guest}/
	@agentSwitch path_regexp ^/api/session/{$PLAYGROUND_SESSION_ID:ses_guest}/agent$
	handle @write {
		handle @allowedSession {
			import to_oc
		}
		handle @agentSwitch {
			import to_oc
		}
		handle {
			respond 403
		}
	}

	# ⑦ 其余请求(会话读、事件流等)→ opencode
	import to_oc
}
