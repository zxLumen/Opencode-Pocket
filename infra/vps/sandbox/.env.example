# 访客沙盒栈的环境变量。服务器上复制为 .env(该文件不入库):
#   ~/Opencode-Pocket/sandbox/.env
#
# 只放沙盒真正需要的两项;不要往里塞博客的密钥(沙盒匿名可玩)。

# 博客 AI 网关令牌(在博客 /admin「AI 密钥」页签发:设每日 token 上限 + 固定便宜模型)
# 沙盒只经 docker_play 内网访问 app:3000/api/ai/v1
PLAYGROUND_AI_TOKEN=change-me-ai-token

# 唯一固定会话 id:访客进站只落在这一条会话里(Caddy 锁定 + init 容器补建)
PLAYGROUND_SESSION_ID=ses_guest

# opencode v2.0.x 强制 Basic 鉴权所需的固定密码。由边缘 Caddy 与容器内辅助服务
# 各自注入到上游,访客侧不可见。请设为足够随机的字符串(不要用 change-me)。
PLAYGROUND_SERVER_PASSWORD=change-me-server-password

# 沙盒镜像 tag(通常不设,用 latest;本仓库 CI 推 <sha> + latest)
# OPENCODE_SANDBOX_TAG=latest

# 会话历史在 UI 上的显示上限(最近多少条;服务端数据不动)。默认 40。
# 共享会话会无限累积,截断可缓解长会话的滚动抖动与加载慢。
# PLAYGROUND_HISTORY_LIMIT=40

# ===== 无头推流(可选;默认不启动)=====
# 把沙盒画面自动推到 YouTube,无需本地电脑开 OBS。
# 开启:`docker compose --profile stream up -d streamer`(见 docs/vps-sandbox.md)。
# YouTube Studio → 直播 → 推流 → 复制「推流密钥」(形如 xxxx-xxxx-xxxx-xxxx-xxxx),保密、勿入库。
# YT_STREAM_KEY=change-me-youtube-stream-key
# 画面来源(默认沙盒工作台)
# STREAM_URL=http://sandbox-caddy/
# STREAM_WIDTH=1280
# STREAM_HEIGHT=720
# STREAM_FPS=15
# STREAM_BITRATE=2500k
# STREAM_PRESET=veryfast
# STREAM_RTMP=rtmp://a.rtmp.youtube.com/live2

# ===== 访客后端自愈 =====
# 容器重建(部署)或崩溃后,辅助服务会自动拉起 8000 端口的访客后端。
# 启动命令写在 /workspace/.sandbox-backend(一行);没有则尝试 launch.js/server.js/package.json:start。
# PLAYGROUND_BACKEND_AUTOSTART=1

# ===== 直播投票 + 自动接棒(可选)=====
# 观众在 YouTube 直播聊天(弹幕)提意见,相同/相近自动合并计票;
# 会话本轮跑完自动把票王发给模型继续,发送后清零(见 docs/vps-sandbox.md)。
# YouTube Data API v3 的 API key(只读公开聊天,不需要 OAuth)。
# YT_API_KEY=change-me-youtube-api-key
# 直播视频 id(或完整 watch 链接,会自动解析)
# YT_VIDEO_ID=dQw4w9WgXcQ
# 弹幕源:youtube | bilibili | off(留空 = 按上面配置自动选)
# CHAT_SOURCE=bilibili
# B 站直播间号(短号或真实 room_id)。匿名读公开弹幕(需 WBI 签名过风控),无需登录;开播需实名,试水可用公开房间。
# BILI_ROOM_ID=1854259242
# 可选:低人气房间匿名常收不到弹幕,填自己账号的 SESSDATA 以「已登录观众」读取。
#   SESSDATA 是登录态(敏感):只放本文件,建议用小号,仅用于读取。
# BILI_SESSDATA=xxxxxx%2Cxxxxxx%2Cxxxxxx
# BILI_UID=123456789
# BILI_BUVID3=XXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXXinfoc
# 榜单管理令牌(随机字符串;不设则管理接口关闭)
# PLAYGROUND_ADMIN_TOKEN=change-me-admin-token
# 总开关(0 关闭直播投票)
# PLAYGROUND_LIVE=1
# 票王自动发送(0 = 只投票、不自动发)
# PLAYGROUND_AUTODIRECT=1
# 票王最小票数(0 = 不设门槛,任意票数即触发)
# PLAYGROUND_MIN_VOTES=0
# 两次自动发送的最小间隔(秒;0 = 无冷却)
# PLAYGROUND_COOLDOWN_SEC=0
# 弹幕侧审核(默认关闭):0=不过滤,所有弹幕都进投票,交由模型在接收时自行判断是否执行
# PLAYGROUND_MODERATE=0
# 若要开启:both | rules | llm | off
# PLAYGROUND_MODERATE_MODE=both
# 规则屏蔽词(逗号分隔;仅审核开启时生效)
# PLAYGROUND_BLOCKLIST=广告,加群,微信
# 审核失败时:open=放行 / closed=丢弃
# PLAYGROUND_MODERATE_FAIL=open
# 阻塞(agent 提问)处理:vote=逐题弹幕投票(默认) / auto=网关代答 / pause=只暂停人工答
# PLAYGROUND_QUESTION_POLICY=vote
# 问题投票时长(秒,自该题首条弹幕起)
# PLAYGROUND_QUESTION_VOTE_SEC=20
# 权限申请代答:reject(默认,安全) | once | always
# PLAYGROUND_PERMISSION_POLICY=reject
# 最大自动轮数(0 = 不限;防无限烧预算)
# PLAYGROUND_MAX_ROUNDS=0
# AI 语义合并(0 = 只做精确去重)
# PLAYGROUND_MERGE=1
# 合并检查间隔(毫秒)
# PLAYGROUND_MERGE_INTERVAL_MS=30000
