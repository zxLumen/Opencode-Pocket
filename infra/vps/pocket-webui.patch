diff --git a/packages/app/src/composer/voice.ts b/packages/app/src/composer/voice.ts
new file mode 100644
index 0000000000..6b5e2eafdd
--- /dev/null
+++ b/packages/app/src/composer/voice.ts
@@ -0,0 +1,172 @@
+import { createSignal, onCleanup } from "solid-js"
+
+export type VoiceStatus = "idle" | "recording" | "transcribing"
+
+/** 单次录音上限。服务端也限制 60 秒，超长会被拒。 */
+const MAX_RECORDING_MS = 60_000
+
+/** 太小或全是静音的录音没必要上传。 */
+const MIN_AUDIO_BYTES = 1_200
+
+const MIME_CANDIDATES = ["audio/webm;codecs=opus", "audio/webm", "audio/mp4", "audio/ogg;codecs=opus"]
+
+function pickMimeType() {
+  if (typeof MediaRecorder === "undefined" || typeof MediaRecorder.isTypeSupported !== "function") return undefined
+
+  return MIME_CANDIDATES.find((type) => MediaRecorder.isTypeSupported(type))
+}
+
+function permissionMessage(error: unknown) {
+  const name = error instanceof DOMException ? error.name : ""
+  if (name === "NotAllowedError" || name === "SecurityError") return "麦克风权限被拒绝，请在浏览器设置里允许后重试"
+  if (name === "NotFoundError") return "没有找到麦克风"
+  if (name === "NotReadableError") return "麦克风被其它应用占用"
+  return error instanceof Error ? error.message : "无法打开麦克风"
+}
+
+/**
+ * 浏览器语音输入：录音 → 上传到 /pocketd/asr 转写 → 回调文本。
+ *
+ * 和文本输入并存：按钮只负责「按住/点按说话」，识别完成后由调用方决定是填入还是直接发送。
+ */
+export function createVoiceInput(options: {
+  onTranscript: (text: string) => void
+  onError: (message: string) => void
+  authHeader?: () => string | undefined
+}) {
+  const [status, setStatus] = createSignal<VoiceStatus>("idle")
+  let recorder: MediaRecorder | undefined
+  let stream: MediaStream | undefined
+  let chunks: Blob[] = []
+  let timer: ReturnType<typeof setTimeout> | undefined
+  let cancelled = false
+  let disposed = false
+
+  const supported = () =>
+    typeof navigator !== "undefined" &&
+    typeof navigator.mediaDevices?.getUserMedia === "function" &&
+    typeof MediaRecorder !== "undefined"
+
+  const release = () => {
+    if (timer) clearTimeout(timer)
+    timer = undefined
+    stream?.getTracks().forEach((track) => track.stop())
+    stream = undefined
+  }
+
+  const stop = () => {
+    if (timer) clearTimeout(timer)
+    timer = undefined
+    if (recorder && recorder.state !== "inactive") {
+      setStatus("transcribing")
+      recorder.stop()
+    }
+  }
+
+  const cancel = () => {
+    cancelled = true
+    if (timer) clearTimeout(timer)
+    timer = undefined
+    if (recorder && recorder.state !== "inactive") recorder.stop()
+    else {
+      release()
+      setStatus("idle")
+    }
+  }
+
+  async function transcribe(blob: Blob) {
+    if (blob.size < MIN_AUDIO_BYTES) {
+      setStatus("idle")
+      options.onError("录音太短了，点麦克风说一句再点一次结束")
+      return
+    }
+
+    setStatus("transcribing")
+    try {
+      const headers: Record<string, string> = { "content-type": blob.type || "audio/webm" }
+      const auth = options.authHeader?.()
+      if (auth) headers.authorization = auth
+
+      const response = await fetch("/pocketd/asr", { method: "POST", headers, body: blob })
+      const data = (await response.json().catch(() => ({}))) as { text?: string; error?: string }
+      if (response.status === 401) throw new Error("登录状态已失效，刷新页面重新连接服务器后再试")
+      if (!response.ok) throw new Error(data.error || `语音识别失败（HTTP ${response.status}）`)
+
+      const text = String(data.text || "").trim()
+      if (!text) {
+        options.onError("没听清，再说一次？")
+        return
+      }
+      if (!disposed) options.onTranscript(text)
+    } catch (error) {
+      options.onError(error instanceof Error ? error.message : "语音识别失败")
+    } finally {
+      if (!disposed) setStatus("idle")
+    }
+  }
+
+  async function start() {
+    if (status() !== "idle") return
+    if (!supported()) {
+      options.onError("当前浏览器不支持录音，请用 Safari / Chrome 打开，并确认是 HTTPS")
+      return
+    }
+
+    cancelled = false
+    try {
+      stream = await navigator.mediaDevices.getUserMedia({
+        audio: { channelCount: 1, echoCancellation: true, noiseSuppression: true, autoGainControl: true },
+      })
+    } catch (error) {
+      options.onError(permissionMessage(error))
+      return
+    }
+
+    const mimeType = pickMimeType()
+    try {
+      recorder = new MediaRecorder(stream, mimeType ? { mimeType, audioBitsPerSecond: 64_000 } : undefined)
+    } catch {
+      release()
+      options.onError("录音初始化失败，请重试")
+      return
+    }
+
+    chunks = []
+    recorder.ondataavailable = (event) => {
+      if (event.data.size > 0) chunks.push(event.data)
+    }
+    recorder.onstop = () => {
+      const type = recorder?.mimeType || chunks[0]?.type || "audio/webm"
+      const blob = new Blob(chunks, { type })
+      chunks = []
+      recorder = undefined
+      release()
+      if (cancelled) {
+        setStatus("idle")
+        return
+      }
+      void transcribe(blob)
+    }
+    recorder.onerror = () => {
+      release()
+      setStatus("idle")
+      options.onError("录音失败，请重试")
+    }
+
+    recorder.start(250)
+    setStatus("recording")
+    timer = setTimeout(stop, MAX_RECORDING_MS)
+  }
+
+  const toggle = () => {
+    if (status() === "recording") stop()
+    else if (status() === "idle") void start()
+  }
+
+  onCleanup(() => {
+    disposed = true
+    cancel()
+  })
+
+  return { status, supported, start, stop, cancel, toggle }
+}
