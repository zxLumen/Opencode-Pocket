# Opencode-Pocket — 追加到 VPS 上「现有 Caddy 容器」的 Caddyfile 的片段。
#
# VPS 上已有一个 caddy:2 容器（docker-caddy-1）占用 80/443，统一管理 example.com 下所有站点。
# 不要另装 Caddy；把下面这段追加到 /home/ubuntu/zxLumen-Blog/docker/Caddyfile 末尾，
# 然后 `docker exec docker-caddy-1 caddy reload --config /etc/caddy/Caddyfile` 即可。
#
# 前置：
#   1) sshd_config 设 GatewayPorts clientspecified（允许反向转发绑定到 172.17.0.1）
#   2) ufw 放行 Docker 网段到宿主机 4096（不放行公网）：
#        sudo ufw allow from 172.16.0.0/12 to any port 4096 proto tcp
#   3) Mac 侧隧道绑定 VPS_TUNNEL_BIND=0.0.0.0（Caddy 容器可访问；由 ufw 限制非公网）
#
# 说明：host.docker.internal 由 compose 的 extra_hosts 映射为 docker0 网关(172.17.0.1)。

pocket.{$DOMAIN} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		# 若被主站 iframe 嵌入，只放行主站（与自身）内嵌
		Content-Security-Policy "frame-ancestors 'self' https://{$DOMAIN}"
		-Server
	}
	# App 的图片上传中继：/pocketd/upload -> pocketd(8788)/upload
	handle /pocketd/* {
		uri strip_prefix /pocketd
		reverse_proxy host.docker.internal:8788
	}
	handle {
		reverse_proxy host.docker.internal:4096 {
			# SSE（/api/event）必须关闭缓冲
			flush_interval -1
		}
	}
}

# 公开：访客沙盒 opencode web（code-sandbox.{$DOMAIN}）。
# 实现整体在本仓库 infra/vps/sandbox/：访客锁定的全部逻辑（重定向 + 写入白名单 + 自建外壳）
# 都在沙盒自带的边缘 Caddy 里；博客 Caddy 这里只做 TLS + 转发到 sandbox-caddy:80。
# 详见 docs/vps-sandbox.md。
code-sandbox.{$DOMAIN} {
	reverse_proxy sandbox-caddy:80 {
		# SSE（/api/event）必须关闭缓冲
		flush_interval -1
	}
}

# 私有：自建 anisette-v3（给 SideStore 自签用；见 docs/ios-sidestore.md 与 infra/vps/anisette/）。
# 安全：随机长路径才放行（handle_path 剥离前缀），其余一律 404；端口 6969 由 ufw 限制为 Docker 网段。
# 部署前把 CHANGE-ME-SECRET-PATH 换成你自己的随机串，三处保持一致：
#   本段 / infra/vps/anisette/README.md / docs/anisette-servers.json
anisette.{$DOMAIN} {
	encode zstd gzip

	header {
		-Server
	}

	handle_path /CHANGE-ME-SECRET-PATH* {
		reverse_proxy host.docker.internal:6969
	}

	handle {
		respond 404
	}
}
